{
  "name": "aashray-admin-api",
  "version": "1.0.0",
  "description": "Aashray Partner Application & Admin Backend API",
  "main": "dist/api.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/api.ts",
    "build": "tsc",
    "start": "node dist/api.js",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "ts-node src/db/db-test.ts && ts-node src/db/services-test.ts",
    "test:db": "ts-node src/db/db-test.ts",
    "test:services": "ts-node src/db/services-test.ts",
    "seed:admin": "ts-node src/db/seedAdmin.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.26.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^10.0.12",
    "uuid": "^11.1.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
